# Bark 推送配置 —— 复制本文件为 .env 再填值。
# .env 已在 .gitignore 中,不会被提交。

# 必填:Bark iOS App 里给你的那串 Device Key
BARK_DEVICE_KEY=REPLACE_WITH_YOUR_DEVICE_KEY

# 可选:Bark 服务器(自建可改)
BARK_SERVER=https://api.day.app

# 可选:推送标题
BARK_TITLE=Claude Code

# 可选:推送图标 URL,留空则不带图标
BARK_ICON=https://raw.githubusercontent.com/jairitAge/bark-icons/main/claude.png

# 可选(只在 ./install.sh codex 或 both 时使用):
# Codex hook 用的独立标题和图标。install.sh 会把这两个值嵌进
# ~/.codex/config.toml 里 hook command 的 --title / --icon 参数,
# 让 Codex 推送有跟 Claude 不同的标题和图标。
CODEX_TITLE=Codex
CODEX_ICON=https://raw.githubusercontent.com/jairitAge/bark-icons/main/codex.png
